DATABASE_URL=postgres://USER:PASS@HOST:5432/DBNAME
OPENAI_API_KEY=sk-your-openai-key
# OpenAI preset examples: gpt-5.5, gpt-5.5-pro, gpt-5.4, gpt-5.4-pro, gpt-5.4-mini, gpt-5.4-nano, gpt-5.2, gpt-5.2-pro
OPENAI_MODEL=gpt-5.5
OPENAI_BASE_URL=https://api.openai.com

LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek preset examples: deepseek-v4-pro, deepseek-v4-flash
DEEPSEEK_MODEL=deepseek-v4-pro
JUROR_DEEPSEEK_MODEL=deepseek-v4-pro
SUMMARY_DEEPSEEK_MODEL=deepseek-v4-pro
AI_PLAYER_DEEPSEEK_MODEL=deepseek-v4-pro
WORLD_DEEPSEEK_MODEL=deepseek-v4-pro
WORLD_OPENAI_MODEL=gpt-5.5

PORT=3001
FRONTEND_URL=http://localhost:5173
GAME_TEST_MODE=false
ADMIN_PASSWORD=password

# Optional: separate AI player defaults for compressed local test games.
# These apply when GAME_TEST_MODE=true unless a specific AI player overrides
# provider/model from the UI.
AI_PLAYER_TEST_PROVIDER=deepseek
AI_PLAYER_TEST_MODEL=deepseek-v4-pro
AI_PLAYER_TEST_BASE_URL=https://api.deepseek.com
AI_PLAYER_TEST_API_KEY=sk-your-test-provider-key
